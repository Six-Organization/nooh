// Prisma schema — noh-app
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Ukuran produk. Untuk alas = kapasitas; untuk item = ukuran item.
enum Size {
  KECIL
  SEDANG
  BESAR
}

/// Jenis produk.
/// COMPONENT = item satuan untuk rakit custom.
/// ALAS = alas/base parcel (dipilih di rakit, punya lead time tier).
/// PACKING = pembungkus (dipilih di rakit bersama alas; kapasitas dari matrix alas×packing).
/// BUNDLE = produk jadi/katalog (punya jenjang harga + lead time per pcs).
enum ProductType {
  COMPONENT
  ALAS
  PACKING
  BUNDLE
}

/// Matrix kapasitas rakit custom: kombinasi ukuran alas × ukuran packing → poin.
/// 9 baris (3×3). Dikelola admin. Mengganti kapasitas lama yang murni dari alas.
model CapacityRule {
  id          Int  @id @default(autoincrement())
  alasSize    Size
  packingSize Size
  capacity    Int // total poin kapasitas untuk kombinasi ini

  @@unique([alasSize, packingSize])
}

/// Booking/lead customer: nomor WA + ringkasan pesanan.
/// Disimpan saat customer checkout (sebelum dibuka WhatsApp) untuk bahan
/// broadcast nanti. `consent` = izin dihubungi untuk promo.
model Booking {
  id        Int      @id @default(autoincrement())
  name      String?
  whatsapp  String // nomor ternormalisasi (format 62..., hanya digit)
  kind      String // "BUNDLE" | "CUSTOM"
  summary   String // ringkasan pesanan (produk, pcs, dsb)
  total     Int? // estimasi total (Rupiah)
  eventDate String? // tanggal acara/ambil (yyyy-mm-dd)
  consent   Boolean  @default(false) // izin dihubungi untuk promo/broadcast
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Kategori/tag produk (mis. dupa, alas sok, isian). Dikelola admin.
model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[] @relation("ProductCategories")
}

/// Produk satuan: HPP (modal), harga jual, stok, foto, ukuran, dan kategori.
model Product {
  id            Int            @id @default(autoincrement())
  name          String
  hpp           Int // harga beli / modal per unit (Rupiah)
  sellPrice     Int // harga jual per unit (Rupiah)
  stock         Int            @default(0)
  imageUrl      String? // URL foto produk (Vercel Blob)
  size          Size? // ukuran item / kapasitas alas
  isBase        Boolean        @default(false) // true = alas (base parcel). Disinkronkan dgn type=ALAS.
  type          ProductType    @default(COMPONENT) // jenis produk (lihat enum ProductType)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categories    Category[]     @relation("ProductCategories")
  leadTimeTiers LeadTimeTier[] // waktu pengerjaan per jumlah pcs (khusus alas)
  quantityTiers QuantityTier[] // jenjang harga + lead time per pcs (khusus bundle)
}

/// Tier waktu pengerjaan alas: jumlah pcs -> berapa hari kerja.
/// mis. Alas Bokor: 1-10 pcs = 3 hari, 11-50 pcs = 7 hari, 51+ = 14 hari.
model LeadTimeTier {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int // batas bawah jumlah pcs (inklusif)
  maxQty    Int? // batas atas (inklusif); null = tanpa batas atas
  days      Int // estimasi hari pengerjaan (hari kalender)

  @@index([productId])
}

/// Jenjang (bracket) produk bundle berdasarkan jumlah pcs.
/// Satu baris = satu rentang pcs dengan harga/pcs dan lead time-nya.
/// mis. 1-9 = Rp150rb/7hari, 10-49 = Rp130rb/14hari, 100+ = Rp100rb/30hari.
/// Tidak ada minimum order: bracket paling bawah mulai dari minQty=1.
model QuantityTier {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int // batas bawah jumlah pcs (inklusif)
  maxQty    Int? // batas atas (inklusif); null = tanpa batas atas
  unitPrice Int // harga jual per pcs di bracket ini (Rupiah)
  leadDays  Int // minimal hari sebelum hari-H untuk jumlah ini

  @@index([productId])
}
